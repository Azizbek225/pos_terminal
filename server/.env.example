# Nusxa oling:  cp .env.example .env   va qiymatlarni o'zgartiring.

# Barcha qurilmalar shu kalit bilan ulanadi (ilova: Sozlamalar > Sinxronlash > API kalit).
# Uzun va tasodifiy bo'lsin, masalan:  openssl rand -hex 24
POS_API_KEY=bu-yerga-uzun-maxfiy-kalit-yozing

# PostgreSQL paroli (docker-compose shu qiymat bilan bazani yaratadi).
POSTGRES_PASSWORD=pos_parol_ozgartiring

# Docker'siz ishga tushirilganda baza manzili:
#   PostgreSQL: postgresql+psycopg://pos:PAROL@localhost:5432/pos
#   Sinov uchun SQLite: sqlite:///./pos.db
POS_DATABASE_URL=sqlite:///./pos.db
